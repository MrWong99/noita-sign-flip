<!-- An implosion (files/scripts/implode_lib.lua spawns it where an imploding projectile died): implosion_pull.lua pulls
     things in for 15 frames, then the ProjectileComponent explodes. implode_lib sets the radius (1/3 of the original),
     the damage (3x), the terrain power and the shooter. No "projectile" tag: black holes and Detonator leave it alone. -->
<Entity name="sf_implosion" tags="sf_implosion">
	<ProjectileComponent
		lifetime="15" speed_min="0" speed_max="0" do_moveto_update="0"
		penetrate_world="1" penetrate_entities="1" collide_with_world="0" collide_with_entities="0"
		on_collision_die="0" on_death_gfx_leave_sprite="0"
		on_death_explode="1" on_lifetime_out_explode="1" explosion_dont_damage_shooter="1" damage="0" >
		<config_explosion
			never_cache="1" explosion_radius="5" damage="1" hole_enabled="1"
			ray_energy="4000000" max_durability_to_destroy="10" create_cell_probability="0" camera_shake="40"
			explosion_sprite="data/particles/explosion_032.xml" explosion_sprite_lifetime="0" particle_effect="1"
			damage_mortals="1" physics_throw_enabled="1" physics_explosion_power.min="1" physics_explosion_power.max="1.6"
			shake_vegetation="1" sparks_enabled="1" sparks_count_min="10" sparks_count_max="20" light_enabled="1"
			stains_enabled="1" audio_enabled="1" >
		</config_explosion>
	</ProjectileComponent>
	<VariableStorageComponent _tags="imp_pull_r" name="imp_pull_r" value_float="0" />
	<VariableStorageComponent _tags="imp_shooter" name="imp_shooter" value_int="0" />
	<VariableStorageComponent _tags="imp_age" name="imp_age" value_int="0" />
	<LuaComponent script_source_file="mods/sign_flip/files/scripts/implosion_pull.lua"
		execute_on_added="0" execute_every_n_frame="1" execute_times="15" />
	<!-- the swirl that shows the pull (like vanilla's projectile gravity field) -->
	<ParticleEmitterComponent
		emitted_material_name="spark_purple_bright" lifetime_min="0.2" lifetime_max="0.4" count_min="6" count_max="10"
		render_on_grid="1" area_circle_radius.max="24" emit_cosmetic_particles="1" is_emitting="1" attractor_force="40"
		emission_interval_min_frames="1" emission_interval_max_frames="1" >
	</ParticleEmitterComponent>
</Entity>
