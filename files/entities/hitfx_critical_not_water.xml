<!-- A flipped data/entities/misc/hitfx_critical_water.xml: hits are critical against targets that are NOT wet. The boost is armed or
     disarmed per target by files/scripts/hitfx_critical_not_water.lua. -->
<Entity>
	<HitEffectComponent
		_tags="hitfx_critical_not_WET"
		effect_hit="CRITICAL_HIT_BOOST"
		value="100" >
	</HitEffectComponent>

	<LuaComponent
		script_source_file="mods/sign_flip/files/scripts/hitfx_critical_not_water.lua"
		execute_every_n_frame="1" >
	</LuaComponent>
</Entity>
