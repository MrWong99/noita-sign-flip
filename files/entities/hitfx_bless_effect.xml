<!-- The blessing on a target, the opposite of data/entities/misc/curse.xml: heals 0.08 (2 hp) per stack every 30
     frames for 300 frames (files/scripts/hitfx_bless.lua). Each further hit adds a stack and restarts the timer. -->
<Entity name="sf_blessing" tags="sf_blessing" >
	<InheritTransformComponent />

	<LuaComponent
		script_source_file="mods/sign_flip/files/scripts/hitfx_bless.lua"
		execute_every_n_frame="30" >
	</LuaComponent>

	<VariableStorageComponent
		_tags="sf_bless_heal"
		name="sf_bless_heal"
		value_float="0.08" >
	</VariableStorageComponent>

	<LifetimeComponent
		_tags="sf_bless_lifetime"
		lifetime="300" >
	</LifetimeComponent>

	<SpriteParticleEmitterComponent
		sprite_file="data/particles/heal_small.xml"
		delay="0"
		lifetime="0"
		color.r="1" color.g="1" color.b="1" color.a="0.8"
		color_change.r="0" color_change.g="0" color_change.b="0" color_change.a="-1"
		velocity.x="0" velocity.y="0"
		gravity.x="0" gravity.y="0"
		velocity_slowdown="0"
		rotation="0"
		angular_velocity="0"
		use_velocity_as_rotation="0"
		scale.x="1" scale.y="1"
		scale_velocity.x="0" scale_velocity.y="0"
		emission_interval_min_frames="30"
		emission_interval_max_frames="30"
		count_min="1" count_max="1"
		randomize_position.min_x="-3"
		randomize_position.max_x="3"
		randomize_position.min_y="-6"
		randomize_position.max_y="0"
		randomize_velocity.min_x="-4"
		randomize_velocity.max_x="4"
		randomize_velocity.min_y="-16"
		randomize_velocity.max_y="-8" >
	</SpriteParticleEmitterComponent>
</Entity>
