<!-- The game effect hitfx_toxic_berserk.xml loads onto the target: vanilla effect_berserk.xml, but lasting as long as
     effect_charm_short.xml (3600 frames), the effect the flipped Toxic Charm would have loaded. -->
<Entity>
	<Base file="data/entities/particles/berserk.xml" >
		<SpriteParticleEmitterComponent
			emission_interval_min_frames="10"
			emission_interval_max_frames="20"
			randomize_position_inside_hitbox="1" >
		</SpriteParticleEmitterComponent>
	</Base>

	<InheritTransformComponent
		_enabled="1" >
	</InheritTransformComponent>

	<GameEffectComponent
		effect="BERSERK"
		frames="3600" >
	</GameEffectComponent>
</Entity>
