<!-- The implode marker of a flipped explosion modifier (files/gun_append.lua): every projectile of the shot implodes
     instead of exploding (files/scripts/implode_lib.lua). A flipped spell's own marker is generated per file by
     files/scripts/opposites_build.lua, with the spell's file as value_string. -->
<Entity>
	<VariableStorageComponent _tags="sf_implode" name="sf_implode" value_string="" />
	<LuaComponent _tags="sf_implode" script_source_file="mods/sign_flip/files/scripts/implode.lua"
		execute_on_added="1" execute_every_n_frame="-1" />
	<LuaComponent _tags="sf_implode" script_source_file="mods/sign_flip/files/scripts/implode_arm.lua"
		execute_every_n_frame="1" remove_after_executed="1" />
	<LuaComponent _tags="sf_implode" script_source_file="mods/sign_flip/files/scripts/implode_death.lua"
		execute_on_removed="1" execute_every_n_frame="-1" />
</Entity>
