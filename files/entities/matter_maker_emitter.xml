<!-- The rock layer of a flipped Matter eater (files/entities/matter_maker.xml), loaded onto the projectile by
     files/scripts/matter_maker.lua. Three parallel trail lines, 1 px apart (the script sets each offset), make a 3 px
     thick bridge with no random scatter, so every Entangled Worlds peer lays the same cells. create_real_particles puts
     the cells straight into the world grid, only into empty cells or gas; rock_static is static, so the trail stays
     where it is put and can be dug like normal rock. -->
<Entity>
	<ParticleEmitterComponent
		_tags="matter_maker"
		emitted_material_name="rock_static"
		create_real_particles="1"
		emit_real_particles="0"
		emit_cosmetic_particles="0"
		emit_only_if_there_is_space="1"
		collide_with_gas_and_fire="0"
		set_magic_creation="1"
		is_trail="1"
		trail_gap="0.5"
		render_on_grid="1"
		count_min="1"
		count_max="1"
		area_circle_radius.min="0"
		area_circle_radius.max="0"
		gravity.y="0"
		x_vel_min="0"
		x_vel_max="0"
		y_vel_min="0"
		y_vel_max="0"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<ParticleEmitterComponent
